#!/bin/bash
# Sourced from ~/.bashrc to load this dotfile repo's bash configuration

source "$(dirname "${BASH_SOURCE[0]}")/../inc/base.sh" || return
source "$DOTFILE_ROOT/inc/settings.sh"
source "$DOTFILE_ROOT/inc/bash/statusbar.bash"

for _dotfile_shared in "${DOTFILE_SHARED_INC[@]}"; do
    # shellcheck source=/dev/null
    source "$DOTFILE_ROOT/inc/${_dotfile_shared}.sh" || {
        echo "dotfile: failed to source ${_dotfile_shared}.sh" >&2
        return 1
    }
done
unset _dotfile_shared

[ -f "$DOTFILE_ROOT/inc/local.sh" ] && source "$DOTFILE_ROOT/inc/local.sh"
