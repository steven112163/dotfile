#!/bin/bash
# Entry point: patch/install/config/status/uninstall this repo into the shell environment

set -euo pipefail

DOTFILE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILE_ROOT

source "$DOTFILE_ROOT/inc/patch.sh"
source "$DOTFILE_ROOT/inc/install.sh"
source "$DOTFILE_ROOT/inc/config.sh"

usage() {
    cat <<'EOF'
Usage: dotfile [subcommand] [--target-root <path>] [--dry-run]

Subcommands:
  patch      Append source lines into .bashrc/.zshrc/.vimrc/.tmux.conf
  install    Install vim-plug and tmux TPM
  config     Apply git and vim-plug configuration
  status     Report patch/install status
  uninstall  Remove patched blocks (does not remove vim-plug/TPM)
  all        Run patch, then install, then config (default)

The subcommand may appear before or after the flags.

Flags:
  --target-root <path>  Operate against <path> instead of $HOME (for testing)
  --dry-run             Preview patch/uninstall changes; refuses install/config/all
                         since those run real network/git/vim commands that have
                         no dry-run equivalent
EOF
}

run_patch() {
    patch_shell_rc bash
    patch_shell_rc zsh
    patch_vim_rc
    patch_tmux_rc
}

run_uninstall() {
    unpatch_shell_rc bash
    unpatch_shell_rc zsh
    unpatch_vim_rc
    unpatch_tmux_rc
}

run_install() {
    install_vim_plug
    install_tmux_tpm
}

run_config() {
    config_git_vim_diff
    config_git_core_editor
    config_git_cache_timeout
    config_vim_plug
}

run_status() {
    local root="${TARGET_ROOT:-$HOME}"
    local shell rc
    for shell in bash zsh; do
        rc="$(get_shell_rc_path "$shell")"
        is_patched "$rc" && echo "$rc: patched" || echo "$rc: unpatched"
    done
    for rc in "$root/.vimrc" "$root/.tmux.conf"; do
        is_patched "$rc" && echo "$rc: patched" || echo "$rc: unpatched"
    done

    is_vim_plug_installed && echo "vim-plug: installed" || echo "vim-plug: missing"
    is_tmux_tpm_installed && echo "tmux TPM: installed" || echo "tmux TPM: missing"
}

subcommand=""
target_root=""
dry_run=0

while [ $# -gt 0 ]; do
    case "$1" in
        --target-root)
            if [ $# -lt 2 ]; then
                echo "dotfile: --target-root requires a path" >&2
                exit 1
            fi
            case "$2" in
                -* | "")
                    echo "dotfile: --target-root requires a non-empty path, got '${2:-}'" >&2
                    exit 1
                    ;;
            esac
            target_root="$2"
            shift 2
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        -*)
            echo "dotfile: unknown flag '$1'" >&2
            usage
            exit 1
            ;;
        *)
            if [ -n "$subcommand" ]; then
                echo "dotfile: unexpected extra argument '$1'" >&2
                usage
                exit 1
            fi
            subcommand="$1"
            shift
            ;;
    esac
done

subcommand="${subcommand:-all}"

if [ -n "$target_root" ]; then
    TARGET_ROOT="$target_root"
    export TARGET_ROOT
fi

if [ "$dry_run" = 1 ]; then
    case "$subcommand" in
        install | config | all)
            echo "dotfile: --dry-run has no effect on 'install'/'config' (real network/git/vim commands, not previewable) — refusing '$subcommand'" >&2
            exit 1
            ;;
    esac
    DRY_RUN=1
    export DRY_RUN
fi

case "$subcommand" in
    patch) run_patch ;;
    install) run_install ;;
    config) run_config ;;
    status) run_status ;;
    uninstall) run_uninstall ;;
    all)
        run_patch
        run_install
        run_config
        ;;
    *)
        echo "dotfile: unknown subcommand '$subcommand'" >&2
        usage
        exit 1
        ;;
esac
